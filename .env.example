# Copy to .env and adjust for your machine. Next.js and vitest resolve .env
# files by NODE_ENV; drizzle-kit preloads .env itself. See README > Database.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/authoriza_dev

# How long a session lasts, in minutes, or `null` for one that never expires,
# the way Sanctum's `expiration => null` works. The second value is how long
# the "Keep me signed in" cookie lives, and it is used to start a new session
# once the first has expired. Both are optional and default to 60 and 576000
# (Laravel's 400 days).
SESSION_TTL_MINUTES=60
SESSION_REMEMBER_TTL_MINUTES=576000

# Keys the HMAC of the password hash inside the remember-me cookie, so changing
# a password invalidates every remembered device. At least 32 characters.
APP_SECRET=replace-me-with-32-or-more-random-characters
