# Used by vitest (NODE_ENV=test). Points at a throwaway database that tests wipe.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/authoriza_test

# How long a session lasts, in minutes, or `null` for one that never expires,
# the way Sanctum's `expiration => null` works. The second value is how long
# the "Keep me signed in" cookie lives, and it is used to start a new session
# once the first has expired. Both are optional and default to 60 and 576000
# (Laravel's 400 days).
SESSION_TTL_MINUTES=60
SESSION_REMEMBER_TTL_MINUTES=43200

# Keys the HMAC of the password hash inside the remember-me cookie. This file is
# committed, so the value is deliberately fake: tests only ever verify an HMAC
# they computed themselves in the same run. At least 32 characters.
APP_SECRET=vitest-only-value-not-a-real-secret-0000
